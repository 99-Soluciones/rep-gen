# Copiar a .env y completar. No subir valores reales.
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
MASTER_KEY=

# FileMaker Data API
FM_SERVER=https://
FM_USERNAME=
FM_PASSWORD=
# Tiempo máximo por llamada (ms). Un reporte de rango grande tarda cerca de un
# minuto: no bajar de 120000 donde se sirvan reportes.
FM_REQUEST_TIMEOUT_MS=120000

# Logging
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=logs
SERVICE_NAME=repgen-backend

# ELK (opcional)
ELK_ENABLED=false
ELK_HOST=
ELK_PORT=
